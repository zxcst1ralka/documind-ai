
# scripts/init-env.ps1 or scripts/init-env.sh creates local secrets
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
ENVIRONMENT=development
JWT_SECRET=
DATABASE_NAME=documind
DATABASE_USER=documind
DATABASE_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents

# disabled | ollama | openai
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_EXTERNAL=true
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.15
AI_TIMEOUT=120
AI_CONTEXT_CHARS=28000

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=6
RELEVANCE_THRESHOLD=0.70

MAX_FILE_MB=25
MAX_STORAGE_MB=250
MAX_DOCUMENTS=20
MAX_JOBS=3
MAX_AI_DAILY=50

# Local OCR for scanned PDF pages
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_MAX_PAGES=30
OCR_PAGE_TIMEOUT=15
OCR_DOCUMENT_TIMEOUT=120
